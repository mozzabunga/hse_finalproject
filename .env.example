# ==============================================================================
# PT MINDA AUTOMOTIVE INDONESIA - HSE PORTAL (.env)
# ==============================================================================

# Application Environment
APP_NAME="PT MINDA HSE Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/hse-portal
APP_TIMEZONE=UTC
APP_DEFAULT_LANG=en

# MANDATORY: Generate a secure 32-character key (no default provided)
APP_SECRET=

# MySQL Database Configuration (Single Database Name: minda_hse_portal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minda_hse_portal
DB_USERNAME=minda_hse
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Email & Notifications Webhook (Official Cloudflare Worker Endpoint)
NOTIFICATION_WEBHOOK_URL="https://minda-hse-connector.mozza-bunga-tarmuji-07.workers.dev/api/v1/hazards/realtime-notify"
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_FROM_NAME="HSE Management PT Minda Automotive Indonesia"
NOTIFICATION_FROM_EMAIL=noreply@mindaauto.co.id

# Upload Storage Settings
UPLOAD_MAX_FILESIZE_MB=5
UPLOAD_DIRECTORY=storage/uploads/evidence
